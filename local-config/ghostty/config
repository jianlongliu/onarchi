# Font Configuration
# 抄自另一台机器（2026-10-18），修正了对面那份的两处问题：
#   1. 对面注释写了 CJK fallback 但第二行 font-family 被写成了和第一行相同的值 ⇒ 兜底其实没生效
#   2. 这里显式补上 CJK 行。ghostty 的中文回退不走 fontconfig 的 monospace 规则，
#      必须自己声明，否则汉字会落到系统排序的任意 CJK 字体上。
# font-family = FiraCode Nerd Font Mono
font-family = "GoogleSansCode Nerd Font"
font-family = "Noto Sans CJK SC"
font-style = Regular
font-size = 11

# Window Configuration
window-decoration = false
window-padding-x = 12
window-padding-y = 12
background-opacity = 0.85
# niri 不实现 KDE blur 协议，ghostty 自带模糊在 niri 上无效且会双层模糊，磨砂交给 niri 的 background-effect
background-blur-radius = 0

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 3023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# 终端里的复制反馈交给 niri 垫片的 OSD 卡片（见 ~/bin/omarchy-universal-clipboard）：
# ghostty 自己的 libnotify 吐司在本机不显示，所以两个都关掉。
app-notifications = no-clipboard-copy,no-config-reload

# Key bindings for common actions
# Omarchy 风格通用剪贴板：Super+C/V/X 由 niri 抓走（binds.kdl 里的
# omarchy-universal-clipboard 垫片），终端这一侧只认 Insert 系键（上游同款）。
# 另加 super+ 变体：niri 上物理按住的 SUPER 会并进注入的和弦，
# 客户端实际会收到 Super+Ctrl+Insert / Super+Shift+Insert。
keybind = control+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard
keybind = super+ctrl+insert=copy_to_clipboard
keybind = super+shift+insert=paste_from_clipboard
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Material 3 UI elements
unfocused-split-opacity = 0.7
unfocused-split-fill = #44483d

# Tab configuration
gtk-titlebar = false

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# Rando stuff
gtk-single-instance = true

# Dynamic theme colors (Omarchy writes this per theme)
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"
