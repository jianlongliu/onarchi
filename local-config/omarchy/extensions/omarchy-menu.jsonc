{
  // niri port overrides.
  //
  // 本文件是用户层 override：在仓库外 → `omarchy update`（git pull）碰不到，
  // 且被 FileView 盯着、热重载。合并按 id 覆盖默认项，所以这里复用默认的
  // dotted id；label/icon 建议一并带上，否则合并后会退化成 id。
  //
  // 分区：① 屏蔽（niri 无对应）② 暂未接上（能实现，待改写）③ 已核实可用

  // niri 上根本没有对应功能的两条 → 直接从 Trigger 里屏蔽（when:false 就是隐藏；
  // label/icon 一并带上，将来若取消隐藏不会退化成 id）。
  //   Mirror Display：niri 无镜像输出；Workspace Layout：dwindle/scrolling 是 Hyprland 语义。
  // Window Gaps 2026-09-24 放出来了（用户定的「现在可以做」）：垫片
  //   `omarchy-hyprland-window-gaps-toggle` + `~/.config/niri/layout-no-gaps.kdl`（config 里
  //   一条 `include optional=true`）就是 niri 缺的那个运行时开关，见 docs/shims.md §4。
  // 图标转义注意：>U+FFFF 的码点必须写成 UTF-16 代理对（JSON.parse 的 \u 只吃 4 位十六进制）。
  // 例：Screensaver 的 U+F1104 = \udb84\udd04；写成 \uf1104 会被当成 U+F110 + '4'。
  "trigger.hardware.mirror-display": {"icon":"\udb80\udf79","label":"Mirror Display","when":"false"},
  "trigger.toggle.workspace-layout": {"icon":"\udb84\udcac","label":"Workspace Layout","when":"false"},

  // 暂时不可用（本机缺依赖或需要改写实现，见 §8 第 21 条那批 override）
  // 注：Capture → Color 的 override 已撤（2026-09-19 装了 hyprpicker 并在 niri 上实测能抓屏），
  //     现在走上游默认动作 `pkill hyprpicker || hyprpicker -a`。
  "trigger.toggle.nightlight": {"action":"omarchy-notification-send '暂时不可用' '夜灯：niri 无 Hyprsunset，需 wlsunset 之类替代'"},
  "trigger.hardware.laptop-display": {"action":"omarchy-notification-send '暂时不可用' '笔记本屏幕开关：niri 需改用 niri msg output'"},
  "trigger.toggle.one-window-ratio": {"action":"omarchy-notification-send '暂时不可用' '单窗口方形比例：Hyprland 专属'"},

  // 2026-09-19 用户要求：屏蔽 + 禁用 screensaver（idle 到 150s 就弹，很烦）。
  // 「禁用」本体**不在这里**——是官方开关 `~/.local/state/omarchy/toggles/screensaver-off`
  // （`omarchy-toggle screensaver-off` 打开它），omarchy-launch-screensaver 见到就直接 exit 1。
  // 下面这些是「屏蔽」：它们是唯独几条带 `force`、能绕过那个开关的入口
  // （System 菜单、Trigger→Toggle、Style→Screensaver 那组 branding）——全部隐藏。
  // 隐藏是「只有显式 false 才生效」的 when 表达式，父项隐藏后子项也不会被渲染。
  "system.screensaver": {"icon":"\udb84\udd04","label":"Screensaver","when":"false"},
  "trigger.toggle.screensaver": {"icon":"\udb84\udd04","label":"Screensaver","when":"false"},
  "style.screensaver": {"icon":"\udb84\udd04","label":"Screensaver","when":"false"},
  "style.screensaver.text": {"icon":"\uf044","label":"Edit Text","when":"false"},
  "style.screensaver.image": {"icon":"\uf03e","label":"Set From Image","when":"false"},
  "style.screensaver.default": {"icon":"\uf46a","label":"Restore Default","when":"false"},

  // niri port: Learn → 原 "Hyprland" 指 wiki.hypr.land，本机跑 niri，改指 niri 官方文档站
  // （niri 的仓库/wiki 已迁到 niri-wm，文档站是 niri-wm.github.io/niri）。
  // 复用同一 id 覆盖；label/icon 必须一起带上，否则合并时会回退成 id。
  "learn.hyprland": {"icon":"\uf359","label":"niri","action":"omarchy-launch-webapp 'https://niri-wm.github.io/niri/'"},

  // niri port: setup items open the modular config files. After the niri
  // config was split into includes, config.kdl is just `include`s, so the
  // root file is near-empty — point each at the file that holds its settings.
  // Override (not the repo default) so it hot-reloads and survives omarchy update.
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"omarchy-launch-config-editor \"$HOME/.config/niri/monitor.kdl\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","action":"omarchy-launch-config-editor \"$HOME/.config/niri/binds.kdl\""},
  "setup.input": {"icon":"","label":"Input","action":"omarchy-launch-config-editor \"$HOME/.config/niri/input.kdl\""},

  // 2026-09-22 屏蔽以下 6 个 id（= 5 个菜单项）：本机要么没有对应功能，要么动作链在本机必失败。
  //   style.unlock           本机无 LUKS（lsblk 无 crypt、/etc/crypttab 空），它主题化的是不存在的磁盘解锁屏；
  //                          且 omarchy-plymouth-set 的 root 事务要求 $OMARCHY_PATH 归 root 或 /etc/omarchy.conf
  //                          授权，本机两者都不成立 => 必拒；就算过了末尾还会 mkinitcpio -P 重建 initramfs。
  //   install.webapp         能造 .desktop，但 Exec 走 omarchy-launch-webapp：默认浏览器
  //                          (userapp-Firefox-W32OS3.desktop) 不在白名单 => 回落 chromium.desktop，本机没装
  //                          chromium => 解析出空命令，造出来的启动器点了没反应。
  //   install.preinstalls    本机无 Omarchy 仓库（pacman.conf 只有 core/extra/multilib/archlinuxcn），包表里
  //                          的 aether/cliamp/omacut/omacalc/omawrite 任何仓库都查不到 => omarchy-pkg-add 整笔失败。
  //   update.channel         stable/rc/edge 会把 Omarchy 自家仓库写进 pacman 配置；dev 还会 git clone 上游到
  //                          ~/omarchy 并 omarchy-dev-link（写 /etc/omarchy.conf、改 OMARCHY_PATH）。
  //   update.config.plymouth 同 unlock 那套 root 事务（且 /usr/share/plymouth/themes/omarchy 不存在）=> 必拒。
  //   update.config.shell    omarchy-refresh-config 会拿 $OMARCHY_PATH（Sep-19 那份拷贝）的 shell.json
  //                          盖掉本机调优版，再 omarchy-bar defaults + 重启壳。
  //   这 6 条都是 when:"false" 显式隐藏（只有显式 false 才生效），label/icon 从默认项复制，取消隐藏时不会退化成 id。
  //   本轮按用户决定不动：Remove 侧的 remove.preinstalls（脚枪，会 rm agent CLI 包装 + omarchy-pkg-drop）；
  //   Learn 里 5 条走 omarchy-launch-webapp 的文档链接（同 install.webapp 的根因，只记档）。
  "style.unlock": {"icon":"󰟵","label":"Unlock","when":"false"},
  "install.webapp": {"icon":"","label":"Web App","when":"false"},
  "install.preinstalls": {"icon":"󰏓","label":"Preinstalls","when":"false"},
  "update.channel": {"icon":"󰔫","label":"Channel","when":"false"},
  "update.config.plymouth": {"icon":"󱣴","label":"Plymouth","when":"false"},
  "update.config.shell": {"icon":"󰍜","label":"Shell","when":"false"},

  // 2026-09-27 文案按规范重写（用户："pacman 和 AUR 那文字描述太潦草，遵循 omarchy 设计规范"）：
  //   Entry schema 见 `$OMARCHY_PATH/docs/menu.md` —— `label` 是行标题，取与同菜单其它行同构的
  //   名词短语（对照 Firmware / Timezone / Extra Themes / Plugins；工具名不等于"要更新的对象"）；
  //   `description` 是规范里唯一的描述字段，**只在搜索时**显示在行下，并参与搜索（平时不显示）。
  //   ⚠ 它的匹配是 `MenuModel.termInSearchWords`：按空白切成词后**精确相等**才算命中，所以别写
  //     `(pacman -Syu)` 这类带括号/标点的写法 —— 那样搜 "pacman" 永远匹配不到（label / leaf id
  //     那一侧走的才是子串匹配）。
  //   ⇒ update.omarchy 由 "Pacman" 改为 "System"（动作依旧 = 垫片 sudo pacman -Syu），
  //     update.aur 由 "AUR" 改为 "AUR Packages"，三条一起补齐 description。
  // 2026-09-22 用户要求：Update 菜单把 "Omarchy" 改成 "Pacman"，并新增 AUR / Plugins 两条更新入口。
  //   三行都走演示终端包装器（本机 2026-09-22 实测：窗口起得来、`tty`=/dev/pts/N、sudo 能弹密码框）。
  //   update.omarchy 只改显示：label 见 2026-09-27 那条（现为 "System"）、图标换成 Arch 那枚、iconFont 清空（不清会继续用 omarchy
  //     品牌字体渲染这枚普通 Nerd Font 字形）——动作仍原样裸调 `omarchy-update`，即 ~/bin 垫片 = sudo pacman -Syu
  //     （与 bar 的 system-update 部件同一条路；想更直白就把 action 换成 'sudo pacman -Syu'）。
  //   update.aur = paru -Sua（本机 paru v2.1.0 在位；AUR 另有 ~/bin/yay 垫片，此处按用户要求用 paru）。
  //   update.plugins = `omarchy plugin update`（bin/omarchy-plugin-update）：只动 git 克隆的插件，本机 5 个克隆里
  //     3 个带本地 patch（charlieras262.floating-bar / meviusisback.ai-subs / ronald.input-sources）=> 上游改了同一文件时
  //     `git merge --ff-only` 会拒绝并报 "you have local changes"，需要手工重放 plugin-patches。
  //   注：新增 id 按合并规则**追加在 Update 子菜单末尾**（"Time" 之后）；override 无法改位置，要挪只能改默认文件。
  "update.omarchy": {"icon":"󰣇","iconFont":"","label":"System","description":"Update all system packages with pacman","action":"omarchy-launch-floating-terminal-with-presentation omarchy-update"},
  "update.aur": {"icon":"󰣇","label":"AUR Packages","description":"Update AUR packages with paru","when":"omarchy-setup-security-paru --enabled","action":"omarchy-launch-floating-terminal-with-presentation 'paru -Sua'"},
  "update.plugins": {"icon":"󰐱","label":"Plugins","description":"Update cloned shell plugins with git","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy plugin update'"},

  // 2026-09-22 续（用户"你继续"）：Update 面板逐行体检 —— 只多出一条同 §8 第 27 条性质的死行，一并隐藏。
  //   update.password.drive（Drive Encryption）：脚本第一句 blkid -t TYPE=crypto_LUKS 本机命中 0 个（无 LUKS，理由同 §8 第 27 条
  //     style.unlock），直接走 else 分支打印 "No encrypted drives available." + exit 1 —— 故隐藏。
  //   其余各行体检结论（一律不动）：
  //     update.firmware  本机没装 fwupd（fwupdmgr 缺失）⇒ 脚本会先 omarchy-pkg-add fwupd（extra 里有，装得上），
  //       之后因 /sys/firmware/efi 与 /usr/lib/fwupd/efi/fwupdx64.efi 都在，会 install -D 到**硬编码**的
  //       /boot/EFI/arch/fwupdx64.efi —— 本机 ESP 是 /boot/EFI/{Boot,Linux,systemd}、没有 arch 目录，install -D 会把
  //       /boot/EFI/arch/ 现造出来（无害的野文件）。真正干活的 fwupdmgr refresh --force + update 本身可用，
  //       笔记本固件更新是真有用的 ⇒ 保留可见，只记这个瑕疵（要治就得自己重写 action，绕开那段 EFI 暂存）。
  //     update.time      systemd-timesyncd 本机 enabled + active ⇒ 可用。
  //     update.hardware  audio = systemctl --user restart pipewire 系；wifi/bluetooth = rfkill + nmcli；
  //       trackpad 要 /sys/bus/i2c/drivers/i2c_hid_acpi/i2c-*（本机有 i2c-ELAN0672:00）⇒ 三条都可用。
  //     update.themes    Extra Themes 的守卫命令 omarchy-theme-extras 本机 exit 1 ⇒ 菜单里本来就自动不渲染（实测不在列表里）。
  //     update.process / update.password.user / update.timezone 照旧可用。
  "update.password.drive": {"icon":"","label":"Drive Encryption","when":"false"},

  // 2026-09-27 用户要求（"paru 执行权限加入 menu → settings → security"）：paru 的**可执行位
  // 就是本机 AUR 的总开关**（~/bin/yay 垫片是按"PATH 上找得到可执行的 paru"挑真实帮手的），
  // 所以把它做成 Setup > Security 里一条带勾选的开关，而不是再造一个 TUI。
  //   - 勾选值取脚本自己的 --status（打印 enabled|disabled），与 setup.default.agent.* 同一 idiom
  //     （`[[ "$(…)" == "…" ]]`）。
  //   - 提权走 pkexec + `/etc/polkit-1/rules.d/49-paru.rules`（不放行则本机裸 pkexec 会挂死，
  //     见 docs/local-overrides.md §5），干活的 root 半身是 `/usr/bin/omarchy-setup-security-paru`
  //     —— root 属主副本，不是指回用户可写树的软链。动作外面套演示终端是照 Security 区其它五条
  //     的形状：脚本要先念警告再 `gum confirm`，需要一块能等回车的终端。
  //   - 下面两条 when 守卫是配套：paru 一关，菜单里所有走 AUR 帮手的入口会直接失败（垫片报
  //     "paru not found on PATH"），所以跟着消失（`update.aur` 的守卫写在上文它自己那行，
  //     那条是本文件新增的、字段齐全，所以只加 when 不动其它）。
  //     ⚠ 覆盖默认项必须**整条复述**，不只是 label/icon：`parseMenuJsonc` 会把每个字段补成默认值
  //     （`action:""`、`kind` 由 action 推），而合并是逐字段覆盖 ⇒ 只写 when 会把默认项的 action
  //     冲成空串，条目退化成"没有子项的子菜单"、整个不渲染（本轮实测踩到：install.aur 就这样消失，
  //     行数 14→11）。所以 action 逐字照抄默认项。
  "setup.security.paru": {"icon":"󰣇","label":"Paru (AUR)","checked":"[[ \"$(omarchy-setup-security-paru --status)\" == \"enabled\" ]]","action":"omarchy-launch-floating-terminal-with-presentation omarchy-setup-security-paru"},
  "install.aur": {"icon":"󰣇","label":"AUR","when":"omarchy-setup-security-paru --enabled","action":"if command -v xdg-terminal-exec >/dev/null 2>&1; then xdg-terminal-exec --app-id=org.omarchy.terminal omarchy-pkg-aur-install; else omarchy-launch-floating-terminal-with-presentation omarchy-pkg-aur-install; fi"},
  "remove.package": {"icon":"󰣇","label":"Package","when":"omarchy-setup-security-paru --enabled","action":"if command -v xdg-terminal-exec >/dev/null 2>&1; then xdg-terminal-exec --app-id=org.omarchy.terminal omarchy-pkg-remove; else omarchy-launch-floating-terminal-with-presentation omarchy-pkg-remove; fi"},

  // 2026-09-27 用户要求（"把 ante 以补丁的方式加入 omarchy menu ai 列表"）：把 ante 加进
  // Setup > Default Agent 那 14 条里。**菜单这行不需要补丁**——本文件就是覆盖层（热监听 +
  // 合并），补丁落在命令侧那两处上游脚本上：`bin/omarchy-default-agent` 的 case 新增
  // `ante) … agent_self_managed=true`（ante 不能被 mise 装、自己用 `ante update` 升级 ⇒
  // 新增一个"自管理"分支，presence 就是"PATH 上找得到"），`bin/omarchy-agent` 的启动 case
  // 新增 `ante) command=(ante --yolo)`（ante 的 `--prompt` 是 headless 语义，故不转发 prompt）。
  // 两条都进 niri.patch（24 → 26 文件）。图标 󱚤 借 install.ai 那枚（已确认能渲染，iconFont 留空；
  // Ante 不在 omarchy 品牌字体里）。
  "setup.default.agent.ante": {"icon":"󱚤","label":"Ante","checked":"[[ \"$(omarchy-default-agent)\" == \"ante\" ]]","action":"omarchy-default-agent ante"}
}
