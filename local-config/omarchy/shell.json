{
  "bar": {
    "background": "glassy",
    "floatGap": 8,
    "id": "omarchy.bar",
    "layout": {
      "center": [
        {
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.weather"
        }
      ],
      "left": [
        {
          "id": "jianlongliu.arch-logo"
        },
        {
          "id": "jianlongliu.workspaces"
        }
      ],
      "right": [
        {
          "hidden": [
            "Fcitx"
          ],
          "id": "omarchy.tray"
        },
        {
          "id": "flux"
        },
        {
          "id": "jrmmhm.pocket",
          "members": "flux",
          "pinned": ""
        },
        {
          "id": "ronald.input-sources",
          "showSourceName": false
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "cloneSourceRestores": [
    "jianlongliu.split-lock"
  ],
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "idle": {
    "lock": 1800,
    "screensaver": 300
  },
  "plugins": [
    {
      "id": "jianlongliu.split-lock"
    },
    {
      "id": "io.github.jeocrypto.launchpad"
    }
  ],
  "version": 1
}
