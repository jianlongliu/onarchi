// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Frosted-glass blur for Ghostty. xray false = blur what is really behind the
// window (live frosted glass), not the wallpaper alone. The window must be
// translucent for the effect to show — set background-opacity < 1.0 in
// ~/.config/ghostty/config.
// draw-border-with-background false stops the focus ring from rendering
// *behind* the translucent window (which would show through on the focused one).
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    match app-id="^org.gnome.Nautilus$"
    draw-border-with-background false
    opacity 0.85
    background-effect {
        xray false
        blur true
    }
}
// geometry-corner-radius rounds the window geometry (logical px); clip-to-geometry
// actually clips the rendered content to the rounded shape. Tune the radius to taste.
// Kept equal to the shell's Style.cornerRadius (12) so windows, panel cards, the
// floating bar and niri's now-enabled window shadow all share one radius.
// If CSD apps (their own rounded titlebars) show artifacts, also enable `prefer-no-csd`
// in config.kdl — but that requires restarting apps to take effect.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Omarchy install/remove terminals. Their menu actions go through
// xdg-terminal-exec, whose ghostty desktop entry carries
// X-TerminalArgAppId=--class= -- so the wrapper passes
// --app-id=org.omarchy.terminal and the window arrives under that app-id
// instead of com.mitchellh.ghostty, which means the Ghostty rule above no
// longer matches it. Float it, and repeat the frosted-glass block here or the
// translucent window would show through to hard edges (xray false: blur what
// is really behind the window, same preference as the Ghostty rule).
window-rule {
    match app-id=r#"^org\.omarchy\.terminal$"#
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.7; }
    // Ghostty paints its own 0.85 background (background-opacity in ~/.config/ghostty/config),
    // and niri's opacity multiplies on top of it -- so 0.85 here lands on the same effective
    // 0.72 the plain com.mitchellh.ghostty window gets. Without this line these windows are the
    // only fully opaque-surfaced terminals, i.e. noticeably blacker than the one Mod+Return opens.
    opacity 0.85
    draw-border-with-background false
    background-effect {
        xray false
        blur true
    }
}

// --- Personal app rules carried over from the pre-migration (DMS-era) config ---
// Zen opens maximized. (The old `com.danklinux.dms` rule was dropped with DMS itself.)
window-rule {
    match app-id="^zen-browser$"
    open-maximized true
    background-effect {
        xray false
        blur true
    }
}

// WeChat: maximized + frosted. A background effect is only visible through a
// *semitransparent* window ("otherwise it's fully covered by the opaque window" — niri
// wiki, Window Effects), and this XWayland client paints opaque, so the blur needs the
// compositor to press alpha onto it: that is `opacity`, which niri applies per surface
// on top of the window's own opacity. Without this line the blur rule silently does
// nothing visible.
window-rule {
    match app-id="^wechat"
    open-maximized true
    opacity 0.85
    background-effect {
        xray false
        blur true
    }
}

// --- Floating app windows (2026-09-20) ---
// Window-opening properties CANNOT live in a keybind: `spawn "x"; open-floating true;`
// makes niri reject the whole config ("only one action is allowed per keybind") and it
// silently keeps the previous one. Floating belongs here.
// Nautilus (Mod+E) as a floating panel. It already picks up frosted glass from the
// Ghostty/Nautilus rule above; the `opacity` here is deliberately *later*, and niri lets a
// later matching rule override an earlier value, so this is the one that wins. 0.72 rather
// than 0.85: Nautilus is a plain GTK4 window that paints opaque, so its own alpha is the
// whole story -- 0.72 is the effective transparency the Ghostty windows end up with
// (their 0.85 app background × the rule's 0.85), i.e. the terminal look it is matched to.
window-rule {
    match app-id="^org.gnome.Nautilus$"
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.7; }
    opacity 0.72
}

// Floating TUIs — Yazi (Mod+Y) and btop (Ctrl+Shift+Esc) run inside Ghostty, so they
// arrive under one shared app-id instead of com.mitchellh.ghostty
// (binds.kdl passes --app-id=org.omarchy.float-tui → xdg-terminal-exec → `ghostty --class=`,
// the same route upstream uses to give its install/remove terminals org.omarchy.terminal).
// The frosted-glass block is repeated because the Ghostty rule matches
// com.mitchellh.ghostty and no longer covers this app-id — and so is `opacity 0.85`, for the
// same reason as in the org.omarchy.terminal rule above: it is what makes these two keys look
// like the plain terminal instead of like a black slab.
// Want a different size for one of them? Give that bind its own app-id and copy this rule.
window-rule {
    match app-id=r#"^org\.omarchy\.float-tui$"#
    open-floating true
    default-column-width { proportion 0.7;}
    default-window-height { proportion 0.7;}
    opacity 0.85
    draw-border-with-background false
    background-effect {
        xray false
        blur true
    }
}

// About window / fastfetch TUI (2026-09-22). Upstream gets three things for free
// that niri does not give: Hyprland's blur is GLOBAL (default/hypr/looknfeel.lua
// `blur = { enabled = true }`) so `org.omarchy.about` is frosted without saying so,
// and its float + size live in default/hypr/apps/system.lua (float/center/920x480).
// niri needs both spelled out, and without them the window arrives as a tile with
// a hard-edged translucent background — the "fastfetch 没有磨砂" symptom.
// The app-id comes from omarchy-launch-about's own
// `omarchy-launch-or-focus-tui --app-id=org.omarchy.about`, so the Ghostty rule
// above does not match it.
// Size: 920x540 rather than upstream's 920x480 — the fit code in the launcher is
// skipped once a user fastfetch config exists (`custom_fastfetch_config`), so the
// rule size is what About gets, and the Omarchy module layout is 102 cols x 30 rows
// (cell 7.4x15 logical px, font-size 9 + window-padding 12) ⇒ ~474 px of content.
// niri 26.04 has no `center` rule, so the window is not centred like upstream's.
window-rule {
    match app-id=r#"^org\.omarchy\.about$"#
    open-floating true
    default-column-width { fixed 1020; }
    default-window-height { fixed 700; }
    // Same story as org.omarchy.terminal / org.omarchy.float-tui: ghostty's own 0.85 background
    // times this 0.85 = the plain terminal's effective 0.72.
    opacity 0.85
    draw-border-with-background false
    background-effect {
        xray false
        blur true
    }
}
