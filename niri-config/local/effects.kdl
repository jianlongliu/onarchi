// Frosted-glass background blur for the Omarchy (Quickshell) shell.
// Requires niri >= 26.04. The blurred surfaces must be semitransparent for
// the blur to show — that's done via *-alpha keys in
// ~/.config/omarchy/shell.toml (the user override layer), not here.
//
// xray defaults to true when blur is on: it blurs the wallpaper behind the
// surfaces (cheap, stable). Every rule here sets xray false instead (user
// preference): live blur of whatever is actually behind — experimental, drops
// during open/close animations and while dragging tiled windows.

blur {
    passes 4
    offset 3.5
    noise 0.03
    saturation 1.6
}

// Frosted blur for the SMALL Omarchy chrome surfaces. Match directives are
// OR'd; namespace is a Rust regex.
//
// The OSD is a card-sized layer surface (see Osd.qml), so `blur true` there
// only ever frosts the card.
//
// The toast surface is NOT card-sized: it is a full-screen transparent
// PanelWindow (see notifications/Service.qml) so that adding or removing a
// toast never resizes the surface. `blur true` on a surface that size frosts
// the ENTIRE display — that was the "a notification blurs the whole screen"
// bug (2026-09-20). The notifications rule therefore carries NO `blur true`:
// the toast column is frosted through the ext_background_effect region
// Quickshell sends, the same way the bar and the status-bar popups do it.
// niri has no `ignore_alpha`, so that client region is the only thing keeping a
// full-screen surface's blur off the rest of the display.
//
// The full-screen scrim overlays (menu, clipboard, emojis, image-picker, and
// every status-bar panel: audio/bluetooth/network/power/clock/monitor/
// tailscale/weather/dropbox/wifiqr/speedtest/...) plus the wallpaper and lock
// preview are deliberately NOT matched, so a niri-side blur never frosts the
// entire display.
// (2026-09-21) omarchy-boot-banner is the floating bar plugin's "Thinking…"
// card, shown while the shell boots. It borrows this rule so it is frosted
// exactly like the osd card it copies; its surface is card-sized for the same
// reason the osd one is -- `blur true` frosts everything the rule's surface
// covers.
layer-rule {
    match namespace="^omarchy-(osd|boot-banner)$"
    background-effect {
        blur true
        // xray false: frost the LIVE content behind, not the wallpaper alone
        // (same preference as the bar rule below). Experimental: the blur can
        // drop during window open/close and while dragging a tiled window.
        xray false
    }
}

// Toast frost (2026-09-20). Only `xray` here, NOT `blur true`: the region
// Quickshell sends (Service.qml's BackgroundEffect.blurRegion, tracking the
// toast column) stays the sole blur area. Like the bar below, giving niri a
// rounded region is also what stops its composited-scene sampling from smearing
// the surface's own fill out through its transparent corners into a bright
// halo — the artifact Hyprland fixes with `ignore_alpha`, which niri has no
// equivalent for.
layer-rule {
    match namespace="^omarchy-notifications$"
    background-effect {
        xray false
    }
}

// Floating bar frost. Only `xray` is set here, NOT `blur true`: the rounded
// region comes from the client, exactly like the status-bar popups below.
// xray false (2026-10-04, user: "黑色背景下很怪"): the bar kept showing the blurred
// WALLPAPER through itself, so over anything dark it read as a bright haze instead of
// glass. It now frosts the live content behind it, like the menu/popups/OSD rules above.
// The note below is the PREVIOUS setting (xray true, 2026-09-21 -> 2026-10-04), kept for
// the measurement it records.
// xray true (2026-09-21, user): blur the wallpaper alone. Measured against
// xray false on a live desktop: mean 0.4% of pixels differ, max 12/255 -- i.e.
// invisible -- because niri keeps tiled windows out of the bar's strip. The only
// visible case is a FLOATING window dragged under the bar; flip to false if that
// look is wanted back. The bar has to stay semi-transparent for any of it to show -- shell.toml's
// [bar] background-alpha feeds Color.bar.background, and the plugin now keeps
// that alpha instead of forcing it to 1.
layer-rule {
    match namespace="^omarchy-bar$"
    background-effect {
        xray false
    }
    // 2026-10-04: rounded shadow, same radius as the plugin's own fill (12 logical).
    // geometry-corner-radius only shapes the shadow -- it never clips a layer surface.
    // It dims the outside of the bar but does NOT reshape the silhouette (user: "没感觉").
    // The hard edge over the end caps was the compositor's frost mask
    // (ext_background_effect regions have no antialiasing) -- fixed in the plugin by
    // insetting the frost region 2px, see docs/visual.md §8 第 44 条.
    geometry-corner-radius 12
    shadow {
        on
        color "#00000080"
        softness 30
        spread 5
        offset x=0 y=4
    }
}

// Omarchy menu (2026-09-21, user): real frosted glass over the live windows behind
// the card -- the performance cost is accepted. Like the status-bar popups below,
// this is a full-screen transparent PanelWindow with a card, and Quickshell sends an
// ext_background_effect region for the card only; no `blur true` here either, so the
// client's region stays the sole blur area.
layer-rule {
    match namespace="^omarchy-menu$"
    background-effect {
        xray false
    }
}

// Status-bar popups (audio/bluetooth/network/power/clock/monitor/tailscale/
// weather/dropbox + the agent panel) are full-screen transparent PanelWindows
// with a card. Quickshell sends an ext_background_effect region tracking the
// card, so niri blurs ONLY behind it. xray false frosts the LIVE windows behind
// the card (real frosted glass); xray true would blur the wallpaper instead.
// Only `xray` is set here — NOT `blur true` — so the region from Quickshell
// stays the sole blur area and the full-screen surface never frosts.
// Experimental: the blur drops during window open/close and while dragging a
// tiled window.
layer-rule {
    match namespace="^omarchy-keyboard-panel$"
    background-effect {
        xray false
    }
}

// Blurred overview wallpaper (2026-09-03): while the niri overview is open,
// BlurWallpaper.qml paints a strongly blurred version of the current wallpaper
// INTO the compositor backdrop, replacing niri's flat dark overview color.
// `place-within-backdrop` renders this layer inside the backdrop, on top of
// the backdrop color and behind the window thumbnails. It is invisible on the
// normal desktop (gated by Niri.overviewOpen in QML), so the crisp wallpaper
// from Background.qml stays untouched there.
layer-rule {
    match namespace="^omarchy-blurwallpaper$"
    place-within-backdrop true
}
