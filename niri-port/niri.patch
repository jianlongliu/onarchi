+# other phase shares the one authorization, so it stays off PATH until then.
+omarchy_security_enable_no_update_sudo
+PATH="$OMARCHY_PATH/bin:/usr/bin:/usr/sbin:/bin:/sbin"
+unset OMARCHY_SUDO_NO_UPDATE
+# Helpers that manage their own sudo boundary leave this authorization to us.
+export PATH OMARCHY_UPDATE_SUDO_SESSION=1
+
+update_stay_awake_stopped=0
+sudo_keepalive_pid=""
+
