+# 绝对路径 $OMARCHY_PATH/bin/omarchy-update，PATH-first 的垫片拦不到。
+# 上游那套在本机跑不通（keyring 装不上，set -e 直接终止），故在安全脚手架之前就转走；
+# 垫片自己是普通 sudo 流程、不需要这套脚手架。想跑真身：`omarchy-update --upstream`
+# （它设 OMARCHY_UPDATE_NO_DELEGATE=1，防递归）。
+# 见 docs/local-overrides.md §8 第 19 项。
+if [[ ${OMARCHY_UPDATE_NO_DELEGATE:-0} != 1 && -x $HOME/bin/omarchy-update ]]; then
+  exec "$HOME/bin/omarchy-update" "$@"
+fi
+
+if [[ $- != *p* ]]; then
+  echo "Refusing an unsafe Bash startup." >&2
+  exit 126
