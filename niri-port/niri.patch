+  // ------------------------------------------------------------- boot reveal
+  //
+  // The way out of the greeter is not one continuous picture: greetd hands the
+  // screen over through a text console, so niri comes up on black and this
+  // shell appears on top of it a moment later. From there the first seconds are
+  // the shell assembling itself -- bar widgets load one at a time, the menu
+  // model is re-read, the wallpaper decodes -- and watching that is ugly. So
+  // the bar drops in from behind the screen edge instead of appearing already
+  // built (see BarPanel in plugins/bar/Bar.qml), while the wallpaper underneath
+  // is left alone: no cover, nothing to dim, nothing to mismatch.
+  //
+  // Only a real login arms it: the session command (the split-greeter session
+  // wrapper) drops the marker in the runtime directory and the first shell to
+  // see it removes it, so restarting the shell while working neither moves the
+  // bar nor touches the screen.
+  readonly property string bootRevealMarker:
+    (Quickshell.env("XDG_RUNTIME_DIR") || "/run/user/0") + "/omarchy-boot-splash"
+  property bool bootRevealArmed: false
+  // When the shell counts as assembled. Everything structural -- bar, dock,
+  // widget loaders -- is up within a few hundred ms, but the background service
+  // decodes the wallpaper asynchronously and paints it last, so that image is
+  // the real end of startup. Latched inside the service, so a later theme or
+  // wallpaper switch cannot make the shell look like it is still starting.
