#!/bin/bash
# Warm the Omarchy theme and background pickers after login, so the first
# desktop double-click / style menu picker is not paying cold-cache costs.
#
# Runs from omarchy-picker-warmup.service ~45 s after graphical-session.target.
# Costs: reads the thumbnail cache off disk and lets the picker scripts rebuild
# their rows cache. Nothing here renders, so the first real open still pays the
# driver-side pipeline/first-frame cost.
#
# Disable with: touch ~/.local/state/omarchy/toggles/picker-warmup-off

theme_name=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
current_background=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)

warm() {
  local label="$1"
  shift

  local started ended
  started=$(date +%s%3N)
  "$@" >/dev/null 2>&1 || printf 'warmup: %s failed (ok if the shell was down)\n' "$label" >&2
  ended=$(date +%s%3N)
  printf 'warmup: %-10s %6d ms\n' "$label" "$((ended - started))" >&2
}

# 主题预热必须用 --print-rows：上游 2026-09-27（24f124312 "Make the theme
# picker open instantly"）删掉了 omarchy-theme-switcher 的 --preload，未知参数
# 被忽略后脚本一路走到 exec omarchy-menu-images，等于真的打开选择器——登录约
# 45 秒后主题选择器自己盖在屏幕中央等选择，而不是静默预热。--print-rows 只重建
# 索引/缩略图行并打印，不召唤 UI。
warm theme omarchy-theme-switcher --print-rows

# Order matters: the shell keeps only the last preloaded row set in memory, so
# the background picker goes last. Its arguments must stay identical to
# omarchy-theme-bg-switcher, otherwise the warmed rows are not the ones the real
# open asks for and the work is wasted.
warm background omarchy-menu-images --preload \
  --selected "$current_background" \
  "$HOME/.local/state/omarchy/current/theme/backgrounds" \
  "$HOME/.config/omarchy/backgrounds/$theme_name"

# The row pipeline only stats the cached thumbnails; the decode happens later in
# the picker. Pulling them into the page cache now is what makes the first open
# feel instant.
if [[ -d "$HOME/.cache/omarchy/image-selector" ]]; then
  warm thumbnails bash -c \
    'find "$HOME/.cache/omarchy/image-selector" -maxdepth 1 -type f -name "*.jpg" -print0 | xargs -0 -r cat >/dev/null'
fi
