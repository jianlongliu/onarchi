#!/usr/bin/env python3
"""hyprctl -> niri shim.

Translates the subset of `hyprctl ...` calls that Omarchy v4 (quickshell +
bin scripts) issues into niri equivalents so the Omarchy shell can run on niri.

High-frequency JSON queries (clients/monitors/activewindow/activeworkspace/
devices/binds) are mapped to niri's JSON schema and reshaped into Hyprland's
schema. `dispatch ...` is mapped to `niri msg action ...`. Anything niri has no
equivalent for (hyprsunset nightlight, hl.config cursor, hl.device, hl.monitor
mode, hl.workspace_rule, setprop opaque, ...) degrades to a safe no-op /
sensible default so scripts and the shell never break.

Deliberately jq-free: uses only the stdlib so it runs without installing jq.
"""

import json
import os
import re
import subprocess
import sys
import time


def niri(args):
    try:
        out = subprocess.run(["niri", "msg"] + args,
                             capture_output=True, text=True, timeout=10)
        return out.stdout, out.returncode
    except Exception:
        return "", 1


def _shim_state_path(name):
    base = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return os.path.join(base, "hyprctl-shim-%s" % name)


def _session_id():
    """logind session id for this login: XDG_SESSION_ID, else our uid on a seat."""
    sid = os.environ.get("XDG_SESSION_ID") or ""
    if sid:
        return sid
    try:
        out = subprocess.run(["loginctl", "list-sessions", "--no-legend"],
                             capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return ""
    for line in out.splitlines():
        f = line.split()  # id uid user seat leader type class state tty
        if len(f) >= 4 and f[1] == str(os.getuid()) and f[3] != "-":
            return f[0]
    return ""


def session_locked():
    """True / False / None, from logind's LockedHint.

    Hyprland reports an active ext-session-lock as `LOCK` among the reasons a
    monitor cannot go solitary. niri has no solitary concept, but it does keep
    the standard logind hint (its binary sets LockedHint), so that is what we
    translate from. None means nobody told us.
    """
    sid = _session_id()
    if not sid:
        return None
    try:
        out = subprocess.run(["loginctl", "show-session", sid,
                              "-p", "LockedHint", "--value"],
                             capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    if out.returncode != 0:
        return None
    value = out.stdout.strip().lower()
    if value == "yes":
        return True
    if value == "no":
        return False
    return None


def dpms_on():
    """Whether the outputs are lit — recorded by us, since niri exposes no DPMS state.

    `niri msg outputs` carries no power field, so the only truthful source is the
    path that blanks: omarchy-brightness-display dispatches hl.dsp.dpms through
    this shim, so we are the one place that can see it. niri's own Mod+Shift+P
    bind bypasses us, but niri lights the outputs again on any input (see the
    shipped binds comment) and the wake path runs after that input, so a stale
    "on" cannot outlive the input event that made it stale. Unknown -> on, which
    is the state that cannot skip a needed enable.
    """
    try:
        with open(_shim_state_path("dpms")) as fh:
            return fh.read().strip() != "off"
    except Exception:
        return True


def set_dpms(on):
    try:
        with open(_shim_state_path("dpms"), "w") as fh:
            fh.write("on" if on else "off")
    except Exception:
        pass


def niri_json(args):
    """Run `niri msg -j <args...>` and return parsed JSON or None."""
    out, rc = niri(["-j"] + args)
    if rc != 0 or not out.strip():
        return None
    try:
        return json.loads(out)
    except Exception:
        return None


def niri_action(action):
    # Return niri's real exit status: upstream callers rely on
    # `hyprctl dispatch <lua form> || hyprctl dispatch <legacy form>` fallbacks,
    # so swallowing the code here would make every fallback unreachable.
    return subprocess.run(
        ["niri", "msg", "action"] + action, capture_output=True, text=True
    ).returncode


MONITOR_BOOTSTRAP = {
    "id": 0, "name": "eDP-1", "width": 0, "height": 0, "scale": 1.0,
    "x": 0, "y": 0, "active": True, "disabled": False, "focused": True,
    "refreshRate": 60.0, "make": "", "model": "", "serial": None,
    "availableModes": [],
}


def _focused_output_name():
    out, _ = niri(["focused-output"])
    if not out:
        return "eDP-1"
    line = out.splitlines()[0] if out.splitlines() else ""
    m = re.search(r'\(([^)]+)\)\s*$', line)
    if m:
        return m.group(1).strip()
    return line.split()[-1] if line else "eDP-1"


TRANSFORM_MAP = {"Normal": 0, "90": 1, "180": 2, "270": 3, "Flipped": 4,
                 "Flipped90": 5, "Flipped180": 6, "Flipped270": 7}


def _active_workspace_by_output():
    ws = niri_json(["workspaces"])
    by_output = {}
    if not isinstance(ws, list):
        return by_output
    for w in ws:
        out = w.get("output")
        if out and (w.get("is_active") or w.get("is_focused")):
            by_output[out] = w.get("id", 0)
    return by_output


def cmd_monitors(json_out):
    outputs = niri_json(["outputs"])
    if outputs is None:
        return ("[]" if json_out else "")
    focused = _focused_output_name()
    ws_by_output = _active_workspace_by_output()
    locked = session_locked()
    # `LOCK` is how omarchy-hyprland-session-locked recognises a session lock, and
    # `WORKSPACE` is its spelling for "cannot tell" (exit 2, which callers that
    # branch only on success treat as unlocked). No blockers = plainly unlocked.
    blockers = ["WORKSPACE"] if locked is None else (["LOCK"] if locked else [])
    dpms = dpms_on()
    res = []
    for i, (name, o) in enumerate(outputs.items()):
        # niri marks a disabled output by a null `logical` (there is no `enabled`
        # field in `niri msg --json outputs`); `current_mode` goes null with it.
        # Callers that ask "is an external monitor active" -- the clamshell path's
        # omarchy-hyprland-monitor-external-active -- filter on `disabled == false`,
        # so this must be the real state, not the old hardcoded False.
        logical = o.get("logical") or {}
        disabled = o.get("logical") is None
        mode_idx = o.get("current_mode") or 0
        modes = o.get("modes") or []
        cur = modes[mode_idx] if mode_idx < len(modes) else {}
        transform = TRANSFORM_MAP.get(logical.get("transform"), logical.get("transform", 0))
        res.append({
            "id": i, "name": name,
            # Hyprland reports physical resolution; format_geo divides by scale.
            "width": cur.get("width", logical.get("width", 0)),
            "height": cur.get("height", logical.get("height", 0)),
            "scale": logical.get("scale", 1.0),
            "x": logical.get("x", 0), "y": logical.get("y", 0),
            "transform": transform if isinstance(transform, int) else 0,
            "active": not disabled, "disabled": disabled,
            "focused": (name == focused) or bool(logical.get("is_focused")),
            "refreshRate": (cur.get("refresh_rate") or 60000) / 1000.0,
            "make": o.get("make") or "", "model": o.get("model") or "",
            "serial": o.get("serial"),
            # Hyprland spells each mode as "WxH@R.RRHz" (e.g. "2560x1600@165.00Hz"),
            # and every consumer parses that string: the Display panel's
            # Model.js does `/^(\d+)x(\d+)@/`, and String({...}) is
            # "[object Object]", which matches nothing. Passing niri's objects
            # through unchanged is what emptied the panel's resolution row.
            "availableModes": [
                "%dx%d@%.2fHz" % (m.get("width", 0), m.get("height", 0),
                                  (m.get("refresh_rate") or 0) / 1000.0)
                for m in modes
            ],
            "activeWorkspace": {"id": ws_by_output.get(name, 0)},
            "specialWorkspace": {"id": 0},
            "dpmsStatus": dpms,
            "solitaryBlockedBy": blockers,
            "vrr": bool(o.get("vrr_enabled")),
        })
    if json_out:
        return json.dumps(res)
    # text form
    lines = []
    for m in res:
        lines.append(f"Monitor {m['name']} (ID {m['id']}):")
        lines.append(f"\t{m['width']}x{m['height']}@{m['refreshRate']} at {m['x']},{m['y']}")
        lines.append(f"\tscale: {m['scale']}")
    return "\n".join(lines)


def _window_to_client(w):
    layout = w.get("layout") or {}
    tile = layout.get("tile_size") or [0, 0]
    # Hyprland address is a hex string; niri ids are ints. Keep them in sync.
    address = "0x%x" % w.get("id", 0)
    return {
        "address": address,
        "mapped": True,
        "hidden": False,
        "at": layout.get("tile_pos_in_workspace_view") or layout.get("pos_in_scrolling_layout") or [0, 0],
        "size": [int(tile[0]), int(tile[1])] if tile else [0, 0],
        "workspace": {"id": w.get("workspace_id", 0)},
        "floating": bool(w.get("is_floating", False)),
        "class": w.get("app_id", ""),
        "initialClass": w.get("app_id", ""),
        "title": w.get("title", ""),
        "pid": w.get("pid", 0),
        "focusHistoryID": w.get("id", 0),
        "pinned": False,
        "fullscreen": 0,
        "grouped": [],
        "tags": [],
    }


def cmd_clients(json_out):
    windows = niri_json(["windows"])
    # Both branches must return a string: the caller does `sys.stdout.write(... + "\n")`.
    # Returning a bare [] here raised TypeError whenever the window list was
    # unavailable (niri socket down, output not parseable).
    if windows is None:
        return ("[]" if json_out else "")
    res = [_window_to_client(w) for w in windows]
    if json_out:
        return json.dumps(res)
    lines = []
    for c in res:
        lines.append(f"Client {c['address']} -> {c['title']}")
        lines.append("\tclass: " + c["class"])
        lines.append("\tpid: " + str(c["pid"]))
    return "\n".join(lines)


def cmd_activewindow(json_out):
    w = niri_json(["focused-window"])
    if w is None:
        return ("{}" if json_out else "")
    c = _window_to_client(w)
    if json_out:
        return json.dumps(c)
    lines = [
        f"Window 0x{c['address'][2:]} -> {c['title']}",
        "\tclass: " + c["class"],
        "\tpid: " + str(c["pid"]),
        "\taddress: " + c["address"],
    ]
    return "\n".join(lines)


def cmd_activeworkspace(json_out):
    ws = niri_json(["workspaces"]) or []
    fw = None
    for w in ws:
        if w.get("is_focused") or w.get("is_active"):
            fw = w
    if fw is None and ws:
        fw = ws[0]
    if fw is None:
        return '{"id": 1, "name": "", "monitor": "", "tiledLayout": "dwindle", "windows": 0}' if json_out else ""
    res = {
        "id": fw.get("idx", fw.get("id", 1)),
        "name": fw.get("name") or "",
        "monitor": fw.get("output", ""),
        "tiledLayout": "dwindle",
        "windows": len([w for w in (niri_json(["windows"]) or []) if w.get("workspace_id") == fw.get("id")]),
    }
    return json.dumps(res) if json_out else f"workspace ID {res['id']} ({res['name']}) on {res['monitor']}"


def cmd_devices(json_out):
    keyboards = []
    kl = niri_json(["keyboard-layouts"])
    if kl:
        names = kl.get("names") or []
        cur = kl.get("current_idx", 0)
        for i, name in enumerate(names):
            keyboards.append({
                "name": "keyboard-%d" % i, "active_keymap": name,
                "main": (i == cur),
            })
    res = {"mice": [], "keyboards": keyboards, "touch": [], "tablets": []}
    if json_out:
        return json.dumps(res)
    lines = []
    for k in keyboards:
        lines.append("Keyboard %s:\n\tactive keymap: %s" % (k["name"], k["active_keymap"]))
    return "\n".join(lines)


# niri bind-syntax modifier masks (Hyprland-compatible). Mod maps to Super here
# (niri on a TTY); the user confirmed this account uses Super as Mod.
MOD_MASK = {
    "mod": 64, "super": 64, "meta": 64, "logo": 64, "cmd": 64, "win": 64,
    "ctrl": 4, "control": 4, "alt": 8, "shift": 1,
}


def _unquote_kdl(value):
    value = value.strip()
    if len(value) >= 2 and value[0] in "\"'" and value[-1] == value[0]:
        return value[1:-1].strip()
    return value.strip()


def _kdl_action_to_command(action):
    """Turn a niri bind body ('spawn "x"' / 'spawn-sh "c"' / bare action) into a
    shell command that reproduces it on niri."""
    a = action.strip().rstrip(";").strip()
    if not a:
        return ""
    if a.startswith("spawn-sh"):
        return _unquote_kdl(a[len("spawn-sh"):]) or _unquote_kdl(a)
    if a.startswith("spawn"):
        toks = re.findall(r'"([^"]*)"|\'([^\']*)\'|(\S+)', a[len("spawn"):])
        return " ".join(t[0] or t[1] or t[2] for t in toks)
    return ("niri msg action " + a).strip()


def _kdl_action_description(attrs, action):
    """Description shown in the keybindings menu: hotkey-overlay-title when set,
    else a readable form of the action (or the command for spawn binds)."""
    m = re.search(r'hotkey-overlay-title="([^"]*)"', attrs)
    if m and m.group(1):
        return m.group(1)
    a = action.strip().rstrip(";").strip()
    if a.startswith("spawn"):
        return _kdl_action_to_command(a)
    name = " ".join(a.replace("-", " ").split())
    return name if name else a


def _niri_config_lines(path, seen=None):
    """Read a niri KDL file and recursively expand `include "x.kdl"` directives
    (paths relative to the including file's directory) into a flat line list,
    so bindings stay visible after the config is split into modules."""
    if seen is None:
        seen = set()
    real = os.path.realpath(path)
    if real in seen:
        return []
    seen.add(real)
    try:
        with open(path) as handle:
            raw_lines = handle.readlines()
    except OSError:
        return []
    base = os.path.dirname(path)
    lines = []
    for raw in raw_lines:
        stripped = raw.split("//", 1)[0].strip()
        inc = re.match(r'include\s+"([^"]+)"$', stripped)
        if inc:
            target = os.path.normpath(os.path.join(base, inc.group(1)))
            lines.extend(_niri_config_lines(target, seen))
            continue
        lines.append(raw)
    return lines


def _config_bindings():
    """Parse keybindings out of the niri config (the compositor source of truth
    after the A+C split), following include'd module files, and return
    (modmask, key, description, command) rows."""
    cfg = os.path.expanduser("~/.config/niri/config.kdl")
    lines = _niri_config_lines(cfg)
    if not lines:
        return []

    rows = []
    in_binds = False
    depth = 0
    for raw in lines:
        line = raw.split("//", 1)[0].strip()
        if not line:
            continue
        if not in_binds:
            if re.match(r"binds\s*\{", line):
                in_binds = True
                depth = 1
            continue
        depth += line.count("{") - line.count("}")
        if depth <= 0:
            in_binds = False
            continue

        m = re.match(r"(\S+)\s+", line)
        if not m:
            continue
        chord = m.group(1)
        rest = line[m.end():]
        bm = re.search(r"\{([^}]*)\}", rest)
        if not bm:
            continue
        attrs = rest[:bm.start()]
        action = bm.group(1).strip()
        if not action:
            continue

        modmask = 0
        key = chord
        for part in chord.split("+"):
            part = part.strip()
            if part.lower() in MOD_MASK:
                modmask |= MOD_MASK[part.lower()]
            else:
                key = part
        rows.append((modmask, key, _kdl_action_description(attrs, action),
                     _kdl_action_to_command(action)))
    return rows


def cmd_binds(json_out):
    binds = _config_bindings()
    if json_out:
        return json.dumps([
            {"modmask": m, "key": k, "keycode": 0, "description": d,
             "dispatcher": "exec", "arg": a}
            for (m, k, d, a) in binds
        ])
    lines = []
    for (m, k, d, a) in binds:
        lines.append("bind")
        lines.append("\tmodmask: %d" % m)
        lines.append("\tkey: %s" % k)
        lines.append("\tkeycode: 0")
        lines.append("\tdescription: %s" % d)
        lines.append("\tdispatcher: exec")
        lines.append("\targ: %s" % a)
    return "\n".join(lines)

def cmd_cursorpos():
    return "0, 0"


def _no_gaps():
    """True while the `window-no-gaps` toggle is on.

    Upstream's toggle Lua sets gaps_out/gaps_in, border_size and rounding to 0 at once, and the
    shell re-reads gaps + rounding from here (Commons/Style.qml watches the same flag file), so
    reporting 0 for both is what keeps the shell's own margins in step with the compositor. The
    niri side of the toggle is port-bin/omarchy-hyprland-window-gaps-toggle.
    """
    return os.path.exists(os.path.expanduser(
        "~/.local/state/omarchy/toggles/hypr/window-no-gaps.lua"))


def cmd_getoption(opt, json_out):
    # Hyprland getoption: {option, int, bool, float, str}. Sensible defaults.
    val = {"int": 0, "bool": False, "float": 0.0, "str": "", "option": opt}
    if "rounding" in opt:
        val["int"] = 0 if _no_gaps() else 12
        val["float"] = float(val["int"])
    if "gaps" in opt:
        val["int"] = 0 if _no_gaps() else 8
    return json.dumps(val) if json_out else f"int: {val['int']}"


# ---- dispatch parsing ----------------------------------------------------

def _parse_bare_list(pairs):
    """Parse 'key = value, key = value' inside hl.dsp.focus({...})."""
    m = re.search(r"\{([^}]*)\}", pairs)
    if not m:
        return {}
    body = m.group(1)
    result = {}
    for part in body.split(","):
        kv = part.split("=", 1)
        if len(kv) != 2:
            continue
        k = kv[0].strip()
        v = kv[1].strip().strip('"').strip("'")
        result[k] = v
    return result


def do_dispatch(payload):
    payload = payload.strip()
    # Normalize combined "dispatcher arg" single-string calls.
    parts = payload.split(None, 1)
    dispatcher = parts[0]
    arg = parts[1] if len(parts) > 1 else ""

    # exec / hl.dsp.exec_cmd
    if dispatcher == "exec":
        return do_exec(arg)
    m = re.search(r"hl\.dsp\.exec_cmd\(\s*(.*?)\s*\)", payload)
    if m:
        return do_exec(_unquote(m.group(1)))

    # hl.dsp.dpms
    m = re.search(r"hl\.dsp\.dpms\(\s*\{(.*?)\}\s*\)", payload)
    if m:
        act = re.search(r'action\s*=\s*"(\w+)"', m.group(1))
        if act and act.group(1) == "disable":
            rc = niri_action(["power-off-monitors"])
            if rc == 0:
                set_dpms(False)
            return rc
        rc = niri_action(["power-on-monitors"])
        if rc == 0:
            set_dpms(True)
        return rc

    # plain `dispatch dpms off|on` (the older Hyprland spelling)
    if dispatcher == "dpms":
        if arg.strip().lower() == "off":
            rc = niri_action(["power-off-monitors"])
            if rc == 0:
                set_dpms(False)
            return rc
        rc = niri_action(["power-on-monitors"])
        if rc == 0:
            set_dpms(True)
        return rc

    # hl.dsp.focus({ workspace = "N" }) / hl.dsp.focus({ window = "address:A" })
    m = re.search(r"hl\.dsp\.focus\(\s*\{(.*?)\}\s*\)", payload)
    if m:
        kv = _parse_bare_list("{" + m.group(1) + "}")
        if "workspace" in kv:
            return _focus_workspace(kv["workspace"])
        if "window" in kv:
            return _focus_window_addr(kv["window"])
        if "monitor" in kv:
            return niri_action(["focus-monitor-left"])  # best-effort
        return 0

    # hl.dsp.window.close
    m = re.search(r"hl\.dsp\.window\.close\(\s*\{(.*?)\}\s*\)", payload)
    if m:
        kv = _parse_bare_list("{" + m.group(1) + "}")
        return _close_window_addr(kv.get("window", ""))

    # hl.dsp.window.fullscreen_state
    if "fullscreen_state" in payload or dispatcher == "fullscreenstate":
        return niri_action(["fullscreen-window"])

    # simple dispatchers
    if dispatcher == "workspace":
        return _focus_workspace(arg)
    if dispatcher == "focuswindow":
        return _focus_window_addr(arg)
    if dispatcher == "focusmonitor":
        return niri_action(["focus-monitor-left"])  # best-effort
    if dispatcher == "closewindow":
        return niri_action(["close-window"])
    if dispatcher == "sendshortcut":
        return 0
    # movetoworkspace / movewindowtoworkspace
    if dispatcher.startswith("movewin") or dispatcher == "movetoworkspace":
        return _move_window_to_workspace(arg)

    # Omarchy's named SUPER+V action, which scripts call as
    # `hyprctl dispatch 'o.universal_paste'`. Hyprland runs the Lua binding; on
    # niri the same work lives in the universal-clipboard shim.
    if dispatcher == "o.universal_paste" or "o.universal_paste" in payload:
        return do_exec("omarchy-universal-clipboard paste")

    return 0  # unknown -> safe no-op


def do_exec(cmd):
    cmd = _unquote(cmd)
    if not cmd:
        return 0
    # spawn via shell so pipes/redirects work; niri spawn runs through sh -c
    subprocess.run(["sh", "-c", f'niri msg action spawn -- sh -c {_shq(cmd)}'], capture_output=True, text=True)
    return 0


def _shq(s):
    return "'" + s.replace("'", "'\\''") + "'"


def _unquote(s):
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
        return s[1:-1]
    if s.startswith("[[") and s.endswith("]]"):
        return s[2:-2]
    return s


def _parse_int(v):
    v = v.strip()
    m = re.search(r"(\d+)", v)
    return int(m.group(1)) if m else 0


def _addr_to_id(addr):
    m = re.search(r"0x?([0-9a-fA-F]+)", str(addr))
    if m:
        try:
            return int(m.group(1), 16)
        except Exception:
            pass
    return _parse_int(addr)


def _find_window(world_id):
    windows = niri_json(["windows"]) or []
    for w in windows:
        if w.get("id") == world_id:
            return w
    return None


def _focus_window_addr(addr):
    wid = _addr_to_id(addr)
    return niri_action(["focus-window", "--id", str(wid)])


def _close_window_addr(addr):
    wid = _addr_to_id(addr)
    if not wid:
        return niri_action(["close-window"])
    return niri_action(["close-window", "--id", str(wid)])


def _focus_workspace(ref):
    if isinstance(ref, str):
        ref = _unquote(ref)
    return niri_action(["focus-workspace", str(_parse_int(ref))])


def _move_window_to_workspace(ref):
    if isinstance(ref, str):
        parts = re.split(r"\s+", _unquote(ref))
        ref = parts[-1]
    return niri_action(["move-window-to-workspace", str(_parse_int(ref))])


def cmd_eval(payload):
    # hl.dispatch(hl.dsp.cursor.move(...)) etc. Extract the inner call.
    inner = re.search(r"hl\.dispatch\((.*?)\)", payload)
    if inner:
        return do_dispatch(inner.group(1))
    if "hl.monitor(" in payload:
        return _eval_monitor(payload)
    if "o.workspace_mode(" in payload:
        return _eval_workspace_mode(payload)
    return 0  # hl.config / hl.device / hl.workspace_rule -> no-op


def _eval_workspace_mode(payload):
    """`o.workspace_mode({ workspace = "3", mode = "floating" })`.

    Omarchy's layout cycle calls this to put one workspace into a layout. niri
    has no per-workspace layout: a window is either tiled or floating, and
    `switch-preset-column-width`-style modes do not exist. So there is no niri
    action to run here, and pretending otherwise would be a lie.

    What still has to happen is that the caller can tell whether the change
    took. `bin/omarchy-hyprland-workspace-layout-toggle` fails with
    "needs reload" when this returns non-zero, and it only records a mode when
    the call succeeds -- so returning 0 keeps the mode file honest, and the file
    is what `...-layout-current` reads back (Hyprland's tiledLayout cannot carry
    "floating" at all, so that file is the only record either way).

    Known gap: the mode is recorded but nothing on niri re-lays-out the windows.
    The dock does read it, which is what makes a "floating" workspace show the
    dock. See docs/behavior.md for the state of workspace layouts on niri.
    """
    m = re.search(r'workspace\s*=\s*"?([0-9]+)"?', payload)
    mode = re.search(r'mode\s*=\s*"([a-z]+)"', payload)
    if not m or not mode:
        return 1
    return 0


def _niri_config_dir():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.environ.get("HOME", ""), ".config")
    return os.path.join(base, "niri")


# Written by `hl.monitor({ disabled = … })`; monitor.kdl includes it optionally, and
# that include line is at the *top* of monitor.kdl on purpose: niri keeps the first
# definition of a key, so a block behind the output block is inert (measured both
# ways on niri 26.04 -- see the comment in monitor.kdl).
# The name is deliberately not one of the seven *.kdl files kdl-sync.sh walks,
# so a runtime state file never looks like config drift.
OUTPUT_OFF_OVERLAY = "output-toggle-off.kdl"

# `hl.monitor({ scale = … })` -- the bar's Display panel SCALE row -- is deliberately
# runtime-only: `niri msg output <name> scale N` in _eval_monitor and nothing else. What
# outlives the session is the `scale` line in monitor.kdl, which the machine owns.
# Driving it through a leading config include was tried on 2026-09-25 and cost this panel
# its tuned custom modeline: the mode list is built from the *first* block for an output,
# and that overlay block had no `modeline`, so the panel fell back to the 3840x2400
# preferred mode for the rest of the session. Do not "fix" that by writing config.


def _set_output_disabled(name, off):
    """`hl.monitor({ output = …, disabled = true|false })` -> niri output off/on.

    Not `niri msg output <name> off`: that is a *temporary* change which the
    reload the upstream monitor scripts run right afterwards forgets, and it
    leaves nothing for the next resume to re-apply. The overlay is the same
    mechanism the input-device shim uses -- an optional include that niri
    watches and live-reloads, where "enabled" is just "file absent" -- so the
    state survives reloads and stays out of the mirrored monitor.kdl.

    Returns True when the output is in the requested state.
    """
    overlay = os.path.join(_niri_config_dir(), OUTPUT_OFF_OVERLAY)
    existing = None
    try:
        with open(overlay) as fh:
            existing = fh.read()
    except OSError:
        existing = None

    if off:
        if existing is not None:
            m = re.search(r'output\s+"([^"]+)"', existing)
            if m and m.group(1) == name:
                return True  # already off
        os.makedirs(os.path.dirname(overlay), exist_ok=True)
        with open(overlay, "w") as fh:
            fh.write('output "%s" {\n    off\n}\n' % name)
        # Never leave behind a config niri would reject on its own reload.
        cfg = os.path.join(_niri_config_dir(), "config.kdl")
        try:
            v = subprocess.run(["niri", "validate", "-c", cfg],
                               capture_output=True, text=True, timeout=10)
        except Exception:
            v = None
        if v is not None and v.returncode != 0:
            os.remove(overlay)
            sys.stderr.write(
                "hyprctl: %s made the niri config invalid; removed it again\n" % overlay)
            return False
    else:
        if existing is None:
            return True  # already on
        # Only remove our own file, and only while it is about this output.
        m = re.search(r'output\s+"([^"]+)"', existing)
        if m and m.group(1) != name:
            return True
        os.remove(overlay)

    niri(["action", "load-config-file"])

    # The upstream scripts act on what they see afterwards, and "reported success
    # while the screen stayed on" is the failure this shim exists to avoid, so the
    # effect is read back instead of assumed.
    for attempt in range(2):
        time.sleep(0.3 if attempt == 0 else 0.5)
        outputs = niri_json(["outputs"]) or {}
        state = outputs.get(name)
        if state is None:
            return True  # output gone entirely: nothing left to be wrong
        if (state.get("logical") is None) == bool(off):
            return True
    sys.stderr.write(
        "hyprctl: %s was written but niri still reports %s as %s; "
        "is the `include optional=true \"%s\"` line missing from monitor.kdl?\n"
        % (OUTPUT_OFF_OVERLAY, name, "off" if off else "on", OUTPUT_OFF_OVERLAY))
    return False


def _eval_monitor(payload):
    m = re.search(r"hl\.monitor\(\s*\{(.*?)\}\s*\)", payload)
    if not m:
        return 0
    kv = _parse_bare_list("{" + m.group(1) + "}")
    output = kv.get("output") or kv.get("name") or ""
    if not output:
        return 0
    # niri msg output accepts exactly one action per call; Omarchy's monitor
    # eval bundles mode+scale+position, so apply each separately. Skip `mode`:
    # Omarchy re-sends the *current* mode (as "WxH@Hz") just to hold the
    # resolution, and niri rejects that @Hz form; the output is already on it.
    if kv.get("scale"):
        subprocess.run(["niri", "msg", "output", output, "scale", kv["scale"]],
                       capture_output=True, text=True)
    if kv.get("position") and kv["position"] != "auto":
        pos = re.findall(r"(\d+)", kv["position"])
        if len(pos) >= 2:
            subprocess.run(["niri", "msg", "output", output, "position"] + pos[:2],
                           capture_output=True, text=True)
    if kv.get("disabled") is not None:
        truthy = str(kv["disabled"]).strip().strip('"').lower() in ("true", "1", "yes")
        _set_output_disabled(output, truthy)
    return 0


# ---- main ----------------------------------------------------------------

def main(argv):
    # strip --instance <sig> (multiple-instance hyprland form)
    if len(argv) >= 2 and argv[0] == "--instance":
        argv = argv[2:]

    json_out = False
    if "-j" in argv or "--json" in argv:
        json_out = True
        argv = [a for a in argv if a not in ("-j", "--json")]

    if not argv:
        return 0

    cmd = argv[0]
    rest = argv[1:]

    if cmd == "monitors":
        sys.stdout.write(cmd_monitors(json_out) + "\n")
        return 0
    if cmd == "clients":
        sys.stdout.write(cmd_clients(json_out) + "\n")
        return 0
    if cmd == "activewindow":
        sys.stdout.write(cmd_activewindow(json_out) + "\n")
        return 0
    if cmd == "activeworkspace":
        sys.stdout.write(cmd_activeworkspace(json_out) + "\n")
        return 0
    if cmd == "devices":
        sys.stdout.write(cmd_devices(json_out) + "\n")
        return 0
    if cmd == "binds":
        sys.stdout.write(cmd_binds(json_out) + "\n")
        return 0
    if cmd == "cursorpos":
        sys.stdout.write(cmd_cursorpos() + "\n")
        return 0
    if cmd == "getoption":
        opt = rest[-1] if rest else ""
        sys.stdout.write(cmd_getoption(opt, json_out) + "\n")
        return 0
    if cmd == "dispatch":
        payload = " ".join(rest)
        return do_dispatch(payload)
    if cmd == "eval":
        payload = " ".join(rest)
        return cmd_eval(payload)
    if cmd in ("reload",):
        return 0
    if cmd == "hyprsunset":
        return 0
    if cmd in ("keyword", "setprop", "print", "binary", "hyprctl"):
        return 0
    if cmd in ("instance", "instances"):
        return 0

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
