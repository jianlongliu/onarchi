// Greeter compositor config. Copied to /etc/greetd/split-greeter/niri.kdl by
// install.sh; niri runs it as the `greeter` user on the greeter VT.
//
// GREETER_* values are the greeter's whole configuration surface: login user,
// session command, wallpaper, avatar. They are read by shell.qml through
// Quickshell.env().
hotkey-overlay {
    skip-at-startup
}

environment {
    XDG_SESSION_TYPE "wayland"
    // The greeter's HOME: sync.sh puts the theme's colors.toml / shell.toml in
    // $HOME/.local/state/omarchy/current/theme so the login screen matches the
    // desktop palette.
    // Load-bearing: the greeter user's passwd home is "/", so HOME must be set
    // here or nothing can find the synced theme.
    HOME "/var/lib/greeter"
    GREETER_USER "jianlongliu"
    // Not niri-session directly: greetd gives the session the VT as stdout, so
    // a wrapper gets to repaint the console and move the session's startup
    // output off the screen before niri takes it over (2026-09-21, see
    // docs/lock.md §11.26). It execs niri-session, so nothing else changes.
    GREETER_SESSION "/etc/greetd/split-greeter/session"
    // Wallpaper and avatar come from the selected account's synced artwork
    // (split-greeter-sync); GREETER_ACCOUNTS_DIR moves that directory.
    GREETER_CORNER_RADIUS "10"
    // 1 = a face tool is wired into PAM (see /etc/pam.d/greetd), which is what
    // makes "press Enter on an empty field" ask for a face. install.sh flips it
    // to 0 when howdy is not installed.
    GREETER_FACE "1"
}

gestures {
    hot-corners {
        off
    }
}

layout {
    background-color "#000000"
}

input {
    keyboard {
        xkb
        numlock
    }
    touchpad {
        tap
        dwtp
        natural-scroll
    }
    mouse
    trackpoint {
        accel-speed 0.5
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Amber"
    xcursor-size 30
    hide-when-typing
}

output "eDP-1" {
    // Match the desktop's tuned mode (~/.config/niri/monitor.kdl): 3200x2000@60
    // at scale 2.0. The panel's EDID native mode is 3840x2400, but the desktop
    // deliberately runs 3200x2000; matching it keeps the login screen as sharp
    // as the session instead of rendering at 2560x1600 and letting the panel
    // upscale the whole screen. Never a `mode` line: the monitor panel sends
    // WxH@Hz which niri rejects.
    modeline 414.50 3200 3248 3280 3360 2000 2003 2009 2057 "+hsync" "-vsync"
    scale 2.0
    position x=0 y=0
    variable-refresh-rate
}

// Quickshell is the whole session here: when it exits (login handed to
// greetd), take niri with it so greetd sees the greeter process tree end and
// starts the user's session.
//
// Output goes to $HOME/greeter.log rather than the VT console: once the greeter
// owns the tty, its stdout is only visible on that screen, which makes a failed
// login impossible to diagnose from a session. $HOME is /var/lib/greeter here,
// owned by the greeter user, so the redirect is writable.
spawn-sh-at-startup "log=\"$HOME/greeter.log\"; printf '\n== %s greeter start ==\n' \"$(date -Is)\" >>\"$log\"; exec >>\"$log\" 2>&1; quickshell -p /etc/greetd/split-greeter; niri msg action quit --skip-confirmation"
